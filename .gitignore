.DS_Store
build/
DerivedData/
*.xcodeproj/
*.xcworkspace
xcuserdata/
*.xcuserstate
# The project is generated by XcodeGen, but the SwiftPM pin file is kept
# so CI and xcodebuild resolve the same ZIPFoundation version.
!*.xcodeproj/
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
.omc/

# Environment variables & secrets
.env
.env.local
.env.production
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
id_rsa
id_dsa
.npmrc

# Internal / state / planning artifacts
.omc/
.codex/
.claude/local/
*-todo.md
state*.json
*.log
.pipeline-state.json
